# Copiar a .env.local para desarrollo, o cargar en Vercel → Settings → Environment Variables.
# Supabase → Project Settings → API (URL y clave pública "publishable"/"anon").
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Texto largo al azar; Vercel lo usa para llamar a /api/keepalive una vez por día.
CRON_SECRET=
