# Copiar a .env.local para desarrollo, o cargar en Vercel → Settings → Environment Variables.
# Supabase → Project Settings → API (URL y clave pública "publishable"/"anon").
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional: texto largo al azar para que solo Vercel Cron pueda llamar a /api/keepalive.
CRON_SECRET=
